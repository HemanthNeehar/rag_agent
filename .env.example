# --- RAG Agent Ingestion & Retrieval Configuration ---
# Copy this file to .env and fill in your details. Do not commit .env to version control.

# Deployment mode: local (running FastAPI server locally) or vertex (running inside Vertex Reasoning Engine)
DEPLOYMENT_MODE=local

# --- GCP Configuration ---
# Google Cloud Project ID where services and buckets are located
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCP region for Vertex AI, GCS, and Reasoning Engine
GOOGLE_CLOUD_LOCATION=us-central1
# Force the Google GenAI SDK to route requests through Vertex AI endpoint
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- LLM Configuration ---
# Main model used by the retriever
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
# Comma-separated list of fallback models to cycle through on rate limits
GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-3.5-flash"

# --- Telemetry & Analytics ---
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=TRUE
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=TRUE

# --- database / task Storage ---
# Firestore database ID used for storing session/task metadata (A2A flow)
FIRESTORE_DATABASE_ID=your-firestore-db-id

# --- Vertex AI RAG Engine & Data Store Details ---
# Deployed Reasoning Engine resource path (required for direct chat client invocation)
RAG_AGENT_RESOURCE_NAME=projects/your-gcp-project-number/locations/us-central1/reasoningEngines/your-reasoning-engine-id
# Vertex RAG Data Store ID linked to the ingestion flow
RAG_DATA_STORE_ID=your-confluence-rag-store-id
# Active Vertex AI RAG Corpus ID
RAG_CORPUS_ID=your-rag-corpus-id
RAG_CORPUS_LOCATION=us-central1
RAG_PROJECT_ID=your-gcp-project-number

# --- Google Cloud Storage (GCS) ---
# Name of the GCS bucket used for staging markdown files and storing permissions map
RAG_GCS_BUCKET_NAME=your-gcs-rag-bucket-name

# --- Confluence Ingestion & Crawling Details ---
# Base URL for the target Confluence Cloud instance
CONFLUENCE_URL=https://your-domain.atlassian.net
# Comma-separated list of space keys to crawl (e.g. ENG,HR,SALES)
CONFLUENCE_SPACES=SPACE1,SPACE2

# Option 1: Basic Authentication Credentials (REST API)
CONFLUENCE_USERNAME=service-account-email@yourcompany.com
CONFLUENCE_API_TOKEN=your-atlassian-api-token

# Option 2: OAuth 2.0 Client Credentials (App-only / attachment downloads)
CONFLUENCE_OAUTH_CLIENT_ID=your-confluence-oauth-client-id
CONFLUENCE_OAUTH_CLIENT_SECRET=your-confluence-oauth-client-secret
ATLASSIAN_CLOUD_ID=your-atlassian-cloud-uuid-here

# --- SharePoint Ingestion & Crawling Details ---
# Ingestion mode: graph_api (production) or local_sim (local mock parsing)
SHAREPOINT_INGEST_MODE=graph_api
# Microsoft Entra ID (Azure AD) Tenant ID
SHAREPOINT_TENANT_ID=your-azure-tenant-id-here
# Microsoft App Registration Client ID
SHAREPOINT_CLIENT_ID=your-azure-client-id-here
# Microsoft App Registration Client Secret
SHAREPOINT_CLIENT_SECRET=your-azure-client-secret-here
# Comma-separated list of target SharePoint sites to scan (discoverable via graph API query)
SHAREPOINT_SITES_LIST=SiteName1,SiteName2

# --- Crawl Settings & Concurrency ---
# Set to 'true' to bypass MD5 checksum comparison and force re-processing of all documents
FORCE_REINGEST=false
# Maximum concurrency threads for crawls (prevents throttling while maintaining speed)
SHAREPOINT_INGEST_CONCURRENCY=5
CONFLUENCE_INGEST_CONCURRENCY=5
# Maximum size limit (in Megabytes) for downloading page attachments
SHAREPOINT_MAX_FILE_SIZE_MB=15
CONFLUENCE_MAX_FILE_SIZE_MB=15
PYTHONUNBUFFERED=1

# --- Integrations & Developer Options ---
# Port for the local agent runtime API endpoint
CODE_REVIEW_AGENT_PORT=8015
# GitHub personal access token (if synchronizing back to GitHub repositories)
GITHUB_TOKEN=your-github-token-here
ENABLE_CEL_METADATA_FILTERING=TRUE